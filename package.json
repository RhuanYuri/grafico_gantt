{
  "name": "grafico-gantt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server\" \"vite\"",
    "server": "tsx server/index.ts",
    "web": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^7.0.0"
  }
}
